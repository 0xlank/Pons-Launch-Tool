# =============================================================================
# Pons Launch Tool - Environment Configuration
# Copy this file to .env and replace all placeholder values before running.
# NEVER commit your real .env file to version control.
# =============================================================================

# Required: Telegram Bot token obtained from @BotFather
BOT_TOKEN=0000000000:REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN

# Required: Comma-separated Telegram numeric user IDs for immutable Root Owners
# Root Owners have full access and can manage authorized users via inline UI.
OWNER_TELEGRAM_IDS=123456789

# Optional: Comma-separated initial non-owner Telegram numeric user IDs
# Additional users can also be added/removed dynamically by Root Owners in the bot UI.
ALLOWED_TELEGRAM_IDS=

# Required: Secret encryption key for AES-256-GCM storage of wallet keys and Pinata JWT
# Provide either a 64-character hex string (32 raw bytes) or a strong passphrase (>= 16 chars).
# Generate a 64-hex key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_OR_STRONG_PASSPHRASE

# Optional: Bootstrap network and IPFS defaults for newly initialized user profiles
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# CHAIN_ID=4663
# CHAIN_NAME=Robinhood
# EXPLORER_URL=https://robin.etherscan.io
# PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
